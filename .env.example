# Local Alloyium development defaults.
NATS_URL=nats://127.0.0.1:4222
REDIS_URL=redis://127.0.0.1:6379
SUBS_KEY=alloyium:subscriptions
CONTROL_SUBJECT=alloyium.channels.control

# Default A2A bus settings for local unmanaged agents.
A2A_ENABLED=1
A2A_STREAM=ALLOYIUM_A2A
A2A_SUBJECT_PREFIX=alloyium.a2a.
A2A_TRANSPORT_AUTH=none
A2A_SIG_ALG=ed25519

# Isolated namespace used by `make demo` and `make fleet-up`.
ALLOYIUM_DEMO_STREAM=ALLOYIUM_A2A_DEMO
ALLOYIUM_DEMO_SUBJECT_PREFIX=alloyium.a2a.demo.
ALLOYIUM_DEMO_KEY_PREFIX=alloyium:demo:a2a:
ALLOYIUM_DEMO_STATE_DIR=.alloyium/demo
ALLOYIUM_DEMO_LOG_LEVEL=error
